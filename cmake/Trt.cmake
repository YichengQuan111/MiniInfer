option(MINIINFER_ENABLE_TRT "Build TensorRT CUDA depth backend" OFF)
set(MINIINFER_TRT_INCLUDE "" CACHE PATH "TensorRT 10.8 headers including NvOnnxParser.h")
set(MINIINFER_TRT_LIB "" CACHE PATH "TensorRT shared library directory")
set(MINIINFER_CUDA_RUNTIME "" CACHE PATH "CUDA runtime root with include/ and lib/")
set(MINIINFER_CUDA_NVCC_INCLUDE "" CACHE PATH "CUDA compiler headers (crt/host_defines.h)")

add_library(miniinfer_depth_artifact STATIC "${PROJECT_SOURCE_DIR}/src/depth/artifact.cpp")
add_library(miniinfer::depth_artifact ALIAS miniinfer_depth_artifact)
target_link_libraries(miniinfer_depth_artifact PUBLIC miniinfer::depth_image)
miniinfer_configure_target(miniinfer_depth_artifact)
if(BUILD_TESTING)
    add_executable(test_depth_artifact "${PROJECT_SOURCE_DIR}/tests/test_depth_artifact.cpp")
    target_link_libraries(test_depth_artifact PRIVATE miniinfer::depth_artifact)
    miniinfer_configure_target(test_depth_artifact)
    add_test(NAME depth_artifact_contract COMMAND test_depth_artifact)
endif()
if(MINIINFER_ENABLE_TRT)
    foreach(header NvInfer.h NvOnnxParser.h)
        if(NOT EXISTS "${MINIINFER_TRT_INCLUDE}/${header}")
            message(FATAL_ERROR "Missing TensorRT header ${header}; set MINIINFER_TRT_INCLUDE")
        endif()
    endforeach()
    find_library(MINIINFER_NVINFER NAMES nvinfer libnvinfer.so.10 PATHS "${MINIINFER_TRT_LIB}" NO_DEFAULT_PATH REQUIRED)
    find_library(MINIINFER_NVONNX NAMES nvonnxparser libnvonnxparser.so.10 PATHS "${MINIINFER_TRT_LIB}" NO_DEFAULT_PATH REQUIRED)
    find_library(MINIINFER_CUDART NAMES cudart libcudart.so.12 PATHS "${MINIINFER_CUDA_RUNTIME}/lib" NO_DEFAULT_PATH REQUIRED)
    foreach(pair IN ITEMS "miniinfer_trt_external;MINIINFER_NVINFER"
            "miniinfer_parser_external;MINIINFER_NVONNX" "miniinfer_cuda_external;MINIINFER_CUDART")
        list(GET pair 0 target)
        list(GET pair 1 location)
        add_library(${target} SHARED IMPORTED)
        set_target_properties(${target} PROPERTIES IMPORTED_LOCATION "${${location}}")
    endforeach()
    add_library(miniinfer_depth_trt STATIC "${PROJECT_SOURCE_DIR}/src/depth/trt_runner.cpp")
    add_library(miniinfer::depth_trt ALIAS miniinfer_depth_trt)
    target_include_directories(miniinfer_depth_trt SYSTEM PRIVATE "${MINIINFER_TRT_INCLUDE}"
        "${MINIINFER_CUDA_RUNTIME}/include" "${MINIINFER_CUDA_NVCC_INCLUDE}")
    target_link_libraries(miniinfer_depth_trt PUBLIC miniinfer::depth_artifact
        PRIVATE miniinfer_trt_external miniinfer_parser_external miniinfer_cuda_external)
    miniinfer_configure_target(miniinfer_depth_trt)
    add_executable(depth_engine_builder "${PROJECT_SOURCE_DIR}/apps/depth_engine_builder.cpp")
    target_link_libraries(depth_engine_builder PRIVATE miniinfer::depth_trt)
    miniinfer_configure_target(depth_engine_builder)
    add_executable(depth_trt_cli "${PROJECT_SOURCE_DIR}/apps/depth_cli.cpp")
    target_compile_definitions(depth_trt_cli PRIVATE MINIINFER_CLI_TRT=1)
    target_link_libraries(depth_trt_cli PRIVATE miniinfer::depth_trt)
    miniinfer_configure_target(depth_trt_cli)
    if(BUILD_TESTING)
        add_executable(test_depth_trt "${PROJECT_SOURCE_DIR}/tests/test_depth_trt.cpp")
        target_link_libraries(test_depth_trt PRIVATE miniinfer::depth_trt)
        miniinfer_configure_target(test_depth_trt)
        add_test(NAME depth_trt_artifact_contract COMMAND test_depth_trt)
        set(MINIINFER_DEPTH_TRT_ENGINE "" CACHE FILEPATH "Engine for opt-in GPU lifecycle test")
        set(MINIINFER_DEPTH_TRT_IMAGE "" CACHE FILEPATH "PPM for opt-in GPU lifecycle test")
        if(MINIINFER_DEPTH_TRT_ENGINE AND MINIINFER_DEPTH_TRT_IMAGE)
            add_test(NAME depth_trt_gpu_contract COMMAND test_depth_trt
                "${MINIINFER_DEPTH_TRT_ENGINE}" "${MINIINFER_DEPTH_TRT_IMAGE}")
            set_tests_properties(depth_trt_gpu_contract PROPERTIES TIMEOUT 120 RESOURCE_LOCK depth_gpu)
        endif()
    endif()
endif()
