# Include after Depth.cmake and Trt.cmake (artifact target exists even with TRT OFF).
add_library(miniinfer_depth_sdk STATIC "${PROJECT_SOURCE_DIR}/src/depth/sdk.cpp")
add_library(miniinfer::depth_sdk ALIAS miniinfer_depth_sdk)
target_link_libraries(miniinfer_depth_sdk PUBLIC miniinfer::depth_image
    PRIVATE miniinfer::core miniinfer::depth_artifact)
target_compile_features(miniinfer_depth_sdk PUBLIC cxx_std_17)
if(MINIINFER_ENABLE_ORT)
    target_compile_definitions(miniinfer_depth_sdk PRIVATE MINIINFER_SDK_HAS_ORT=1)
    target_link_libraries(miniinfer_depth_sdk PRIVATE miniinfer::depth_ort)
endif()
if(MINIINFER_ENABLE_TRT)
    target_compile_definitions(miniinfer_depth_sdk PRIVATE MINIINFER_SDK_HAS_TRT=1)
    target_link_libraries(miniinfer_depth_sdk PRIVATE miniinfer::depth_trt)
endif()
miniinfer_configure_target(miniinfer_depth_sdk)
if(BUILD_TESTING)
    add_executable(test_depth_sdk "${PROJECT_SOURCE_DIR}/tests/test_depth_sdk.cpp")
    target_link_libraries(test_depth_sdk PRIVATE miniinfer::depth_sdk)
    if(MINIINFER_ENABLE_ORT)
        target_compile_definitions(test_depth_sdk PRIVATE MINIINFER_SDK_HAS_ORT=1)
    endif()
    miniinfer_configure_target(test_depth_sdk)
    add_test(NAME depth_sdk_contract COMMAND test_depth_sdk)
    set_tests_properties(depth_sdk_contract PROPERTIES TIMEOUT 45)
endif()

# Explicit manual GPU test; no CTest model discovery or implicit GPU workload.
if(BUILD_TESTING AND MINIINFER_ENABLE_TRT)
    add_executable(test_depth_async_gpu "${PROJECT_SOURCE_DIR}/tests/test_depth_async_gpu.cpp")
    target_link_libraries(test_depth_async_gpu PRIVATE miniinfer::depth_sdk)
    miniinfer_configure_target(test_depth_async_gpu)
    add_executable(test_depth_async_stress_gpu "${PROJECT_SOURCE_DIR}/tests/test_depth_async_stress_gpu.cpp")
    target_link_libraries(test_depth_async_stress_gpu PRIVATE miniinfer::depth_sdk)
    miniinfer_configure_target(test_depth_async_stress_gpu)
endif()
