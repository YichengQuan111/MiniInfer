@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@MINIINFER_ENABLE_ORT@ AND NOT TARGET miniinfer_ort_external)
    find_library(MINIINFER_ORT_LIBRARY NAMES onnxruntime HINTS "${MINIINFER_ORT_ROOT}/lib" REQUIRED)
    add_library(miniinfer_ort_external SHARED IMPORTED)
    set_target_properties(miniinfer_ort_external PROPERTIES IMPORTED_LOCATION "${MINIINFER_ORT_LIBRARY}")
endif()
if(@MINIINFER_ENABLE_TRT@)
    find_library(MINIINFER_NVINFER NAMES nvinfer libnvinfer.so.10 HINTS "${MINIINFER_TRT_LIB}" REQUIRED)
    find_library(MINIINFER_NVONNX NAMES nvonnxparser libnvonnxparser.so.10 HINTS "${MINIINFER_TRT_LIB}" REQUIRED)
    find_library(MINIINFER_CUDART NAMES cudart libcudart.so.12 HINTS "${MINIINFER_CUDA_RUNTIME}/lib" REQUIRED)
    foreach(pair IN ITEMS "miniinfer_trt_external;MINIINFER_NVINFER"
            "miniinfer_parser_external;MINIINFER_NVONNX" "miniinfer_cuda_external;MINIINFER_CUDART")
        list(GET pair 0 target)
        list(GET pair 1 location)
        if(NOT TARGET ${target})
            add_library(${target} SHARED IMPORTED)
            set_target_properties(${target} PROPERTIES IMPORTED_LOCATION "${${location}}")
        endif()
    endforeach()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MiniInferTargets.cmake")
check_required_components(MiniInfer)
