if(NOT DEFINED CLI OR CLI STREQUAL "" OR
   NOT DEFINED EXPECTED_VERSION OR EXPECTED_VERSION STREQUAL "" OR
   NOT DEFINED REFERENCE OR REFERENCE STREQUAL "")
    message(FATAL_ERROR "CLI, EXPECTED_VERSION, and REFERENCE are required")
endif()
if(NOT EXISTS "${REFERENCE}/inputs.f32" OR NOT EXISTS "${REFERENCE}/labels.i32")
    message(FATAL_ERROR "REFERENCE must contain inputs.f32 and labels.i32: ${REFERENCE}")
endif()

set(CLI_TIMEOUT_SECONDS 5)

function(check_cli_error name expected_code expected_pattern)
    execute_process(
        COMMAND "${CLI}" ${ARGN}
        RESULT_VARIABLE exit_code
        OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr
        TIMEOUT ${CLI_TIMEOUT_SECONDS})

    if("${exit_code}" STREQUAL "Process terminated due to timeout")
        message(FATAL_ERROR "${name}: CLI timed out after ${CLI_TIMEOUT_SECONDS} seconds\nstdout: ${stdout}\nstderr: ${stderr}")
    elseif(NOT "${exit_code}" MATCHES "^[0-9]+$")
        message(FATAL_ERROR "${name}: could not run CLI: ${exit_code}\nstdout: ${stdout}\nstderr: ${stderr}")
    endif()
    if(NOT exit_code EQUAL expected_code)
        message(FATAL_ERROR "${name}: expected exit ${expected_code}, got ${exit_code}\nstdout: ${stdout}\nstderr: ${stderr}")
    endif()
    if(NOT stdout STREQUAL "")
        message(FATAL_ERROR "${name}: expected empty stdout for an error\nstdout: ${stdout}\nstderr: ${stderr}")
    endif()
    if(NOT stderr MATCHES "${expected_pattern}")
        message(FATAL_ERROR "${name}: stderr did not match '${expected_pattern}'\nstderr: ${stderr}")
    endif()
endfunction()

function(check_cli_success name expected_output)
    execute_process(
        COMMAND "${CLI}" ${ARGN}
        RESULT_VARIABLE exit_code
        OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr
        TIMEOUT ${CLI_TIMEOUT_SECONDS})

    if("${exit_code}" STREQUAL "Process terminated due to timeout")
        message(FATAL_ERROR "${name}: CLI timed out after ${CLI_TIMEOUT_SECONDS} seconds\nstdout: ${stdout}\nstderr: ${stderr}")
    elseif(NOT "${exit_code}" MATCHES "^[0-9]+$")
        message(FATAL_ERROR "${name}: could not run CLI: ${exit_code}\nstdout: ${stdout}\nstderr: ${stderr}")
    endif()
    if(NOT exit_code EQUAL 0 OR NOT stderr STREQUAL "" OR
       NOT stdout STREQUAL expected_output)
        message(FATAL_ERROR "${name}: unexpected result (exit ${exit_code})\nstdout: ${stdout}\nstderr: ${stderr}")
    endif()
endfunction()

set(help_text "Usage: infer_cli --model DIR --input FILE --batch N\n       infer_cli --help | --version\nRun digit MLP inference on N normalized 64-feature FP32 inputs.\nN must be in [1,256].\n")
check_cli_success(help "${help_text}" --help)
check_cli_success(short_help "${help_text}" -h)
check_cli_success(version "MiniInfer ${EXPECTED_VERSION}\n" --version)

check_cli_error(no_arguments 2 "missing required parameter.*--model")
check_cli_error(unknown_argument 2 "unknown argument.*--unknown" --unknown)
check_cli_error(extra_argument 2 "unexpected extra argument.*unused" --version unused)
check_cli_error(help_extra_argument 2 "unexpected extra argument.*unused" --help unused)
check_cli_error(short_help_extra_argument 2 "unexpected extra argument.*unused" -h unused)
check_cli_error(missing_model_value 2 "missing value.*--model" --model)
check_cli_error(missing_input_value 2 "missing value.*--input" --model "${REFERENCE}" --input)
check_cli_error(missing_batch_value 2 "missing value.*--batch" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch)
check_cli_error(missing_input 2 "missing required parameter.*--input" --model "${REFERENCE}")
check_cli_error(missing_batch 2 "missing required parameter.*--batch" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32")
check_cli_error(duplicate_model 2 "duplicate option.*--model" --model "${REFERENCE}" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch 1)
check_cli_error(duplicate_input 2 "duplicate option.*--input" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --input "${REFERENCE}/inputs.f32" --batch 1)
check_cli_error(duplicate_batch 2 "duplicate option.*--batch" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch 1 --batch 2)
check_cli_error(invalid_batch_text 2 "invalid value.*--batch" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch nope)
check_cli_error(invalid_batch_plus 2 "invalid value.*--batch" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch +1)
check_cli_error(invalid_batch_zero 2 "invalid value.*--batch" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch 0)
check_cli_error(invalid_batch_too_large 2 "invalid value.*--batch" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch 257)
check_cli_error(invalid_batch_overflow 2 "invalid value.*--batch" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch 18446744073709551616)
check_cli_error(unknown_after_options 2 "unknown argument.*--unknown" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch 1 --unknown)
check_cli_error(help_with_options 2 "must be used without other arguments" --model "${REFERENCE}" --help)
check_cli_error(version_with_options 2 "unexpected extra argument.*--batch" --version --batch 1)
check_cli_error(model_load_failure 1 "error:.*model directory" --model "${REFERENCE}/missing-model" --input "${REFERENCE}/inputs.f32" --batch 1)
check_cli_error(input_load_failure 1 "error:.*inputs-missing.f32" --model "${REFERENCE}" --input "${REFERENCE}/inputs-missing.f32" --batch 1)
check_cli_error(input_length_mismatch 1 "error:.*inputs.f32.*expected exactly 256 bytes" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch 1)

execute_process(
    COMMAND "${CLI}" --model "${REFERENCE}" --input "${REFERENCE}/inputs.f32" --batch 64
    RESULT_VARIABLE inference_exit_code
    OUTPUT_VARIABLE inference_stdout
    ERROR_VARIABLE inference_stderr
    TIMEOUT ${CLI_TIMEOUT_SECONDS})
if("${inference_exit_code}" STREQUAL "Process terminated due to timeout")
    message(FATAL_ERROR "reference_inference: CLI timed out after ${CLI_TIMEOUT_SECONDS} seconds\nstdout: ${inference_stdout}\nstderr: ${inference_stderr}")
elseif(NOT "${inference_exit_code}" MATCHES "^[0-9]+$")
    message(FATAL_ERROR "reference_inference: could not run CLI: ${inference_exit_code}\nstdout: ${inference_stdout}\nstderr: ${inference_stderr}")
endif()
if(NOT inference_exit_code EQUAL 0 OR NOT inference_stderr STREQUAL "")
    message(FATAL_ERROR "reference_inference: expected exit 0 and empty stderr, got ${inference_exit_code}\nstdout: ${inference_stdout}\nstderr: ${inference_stderr}")
endif()

string(JSON json_batch_type ERROR_VARIABLE json_error TYPE "${inference_stdout}" batch)
if(NOT "${json_error}" STREQUAL "NOTFOUND" OR NOT json_batch_type STREQUAL "NUMBER")
    message(FATAL_ERROR "reference_inference: stdout is not the required JSON object: ${json_error}\nstdout: ${inference_stdout}")
endif()
string(JSON json_batch GET "${inference_stdout}" batch)
if(NOT json_batch STREQUAL "64")
    message(FATAL_ERROR "reference_inference: expected batch 64, got ${json_batch}")
endif()

string(JSON labels_length ERROR_VARIABLE json_error LENGTH "${inference_stdout}" labels)
if(NOT "${json_error}" STREQUAL "NOTFOUND" OR NOT labels_length EQUAL 64)
    message(FATAL_ERROR "reference_inference: expected 64 labels, got ${labels_length}: ${json_error}")
endif()
file(READ "${REFERENCE}/labels.i32" reference_labels_hex HEX)
string(LENGTH "${reference_labels_hex}" reference_labels_hex_length)
if(NOT reference_labels_hex_length EQUAL 512)
    message(FATAL_ERROR "reference_inference: labels.i32 must contain exactly 64 little-endian int32 labels")
endif()
math(EXPR final_label_index "${labels_length} - 1")
foreach(index RANGE 0 ${final_label_index})
    math(EXPR byte_offset "${index} * 8")
    string(SUBSTRING "${reference_labels_hex}" ${byte_offset} 2 byte0)
    math(EXPR byte_offset1 "${byte_offset} + 2")
    math(EXPR byte_offset2 "${byte_offset} + 4")
    math(EXPR byte_offset3 "${byte_offset} + 6")
    string(SUBSTRING "${reference_labels_hex}" ${byte_offset1} 2 byte1)
    string(SUBSTRING "${reference_labels_hex}" ${byte_offset2} 2 byte2)
    string(SUBSTRING "${reference_labels_hex}" ${byte_offset3} 2 byte3)
    math(EXPR expected_label "0x${byte0} + (0x${byte1} << 8) + (0x${byte2} << 16) + (0x${byte3} << 24)")
    if(expected_label GREATER_EQUAL 2147483648)
        math(EXPR expected_label "${expected_label} - 4294967296")
    endif()
    string(JSON actual_label GET "${inference_stdout}" labels ${index})
    if(NOT actual_label STREQUAL "${expected_label}")
        message(FATAL_ERROR "reference_inference: label ${index} is ${actual_label}, expected ${expected_label}")
    endif()
endforeach()

string(JSON logits_length ERROR_VARIABLE json_error LENGTH "${inference_stdout}" logits)
if(NOT "${json_error}" STREQUAL "NOTFOUND" OR NOT logits_length EQUAL 64)
    message(FATAL_ERROR "reference_inference: expected 64 logit rows, got ${logits_length}: ${json_error}")
endif()
math(EXPR final_row_index "${logits_length} - 1")
foreach(row RANGE 0 ${final_row_index})
    string(JSON columns_length ERROR_VARIABLE json_error LENGTH "${inference_stdout}" logits ${row})
    if(NOT "${json_error}" STREQUAL "NOTFOUND" OR NOT columns_length EQUAL 10)
        message(FATAL_ERROR "reference_inference: logit row ${row} must contain 10 values, got ${columns_length}: ${json_error}")
    endif()
    math(EXPR final_column_index "${columns_length} - 1")
    foreach(column RANGE 0 ${final_column_index})
        string(JSON value_type ERROR_VARIABLE json_error TYPE "${inference_stdout}" logits ${row} ${column})
        if(NOT "${json_error}" STREQUAL "NOTFOUND" OR NOT value_type STREQUAL "NUMBER")
            message(FATAL_ERROR "reference_inference: logit [${row},${column}] is not a JSON number: ${json_error}")
        endif()
    endforeach()
endforeach()
